# Core
ENVIRONMENT=development                    # development | test | demo
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24
MONGO_URI=mongodb://mongo:27017/careflow
REDIS_URL=redis://redis:6379/0
USE_MOCK_DB=false

# Seed data — password given to every seeded doctor, admin and patient account
SEED_DEFAULT_PASSWORD=

# LLM
# mock = no model, CareBot answers from rules only. ollama arrives with the failover chain.
LLM_PROVIDER=gemini                        # gemini | mock
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=                         # current free Flash-Lite model ID
GEMINI_LIVE_MODEL=                         # current free Live native-audio model ID
GEMINI_TTS_MODEL=                          # current free Flash TTS model ID
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=

# Intent classifier — needs `pip install -e ".[ml]"`; leave empty for keyword rules only
INTENT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Voice — needs `pip install -e ".[voice]"`. mock/energy run without any speech model.
VOICE_PIPELINE_DEFAULT=live                # live | cascade
STT_PROVIDER=faster_whisper                # faster_whisper | mock
# The first choice; the other real voice stands behind it. Piper is local and English only.
TTS_PROVIDER=gemini                        # gemini | piper | mock
VAD_PROVIDER=silero                        # silero | energy
TTS_CHUNKING=sentence                      # sentence | reply (one TTS request per turn)
# small is the most accurate that fits; base is several times faster on a laptop CPU
WHISPER_MODEL=small
WHISPER_CPU_THREADS=0                      # 0 = automatic (4 at most); try your core count
WHISPER_COMPUTE_TYPE=int8
PIPER_VOICE=en_US-lessac-medium
VAD_SILENCE_MS=500

# Failover
GEMINI_BREAKER_THRESHOLD=3
GEMINI_BREAKER_COOLDOWN_S=60

# Rate limits
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_VOICE_SESSIONS=5/minute
